#!/bin/sh
# charter pre-commit gate. Installed via `git config core.hooksPath .charter/githooks`.
# Runs the same checks as CI on the staged files. Skip with --no-verify; CI runs it again.
ROOT=$(git rev-parse --show-toplevel) || exit 0
[ -f "$ROOT/.charter/bin/charter" ] || exit 0
exec python3 "$ROOT/.charter/bin/charter" --root "$ROOT" check --staged
