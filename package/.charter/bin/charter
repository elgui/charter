#!/usr/bin/env python3
"""charter: the committed-layer CLI. Python 3 standard library only.

  check     run the gates on the change set (--all) or the staged files (--staged)
  probe     run a unit's acceptance probes and print them as evidence lines
  anchors   check that every claim in a markdown deliverable is anchored
  synth     produce the progress synthesis from repository state
  ledger    fold session records into charter/ledger.jsonl; add headless results or human time
  unit      start | stop | show the active unit of work
  decisions regenerate charter/decisions/INDEX.md
  log       summarise the gate log (in the git directory, shared by worktrees)
  setup     activate the git hook in this clone; move 0.1.0 state out of .charter/state/
  config    print the track and opt-ins the gates read; list what in charter/config.json is not applied
  next      where the work stands and what comes next: the active unit, the road, what waits on the owner; read-only
  handover  who commits what is staged (the owner only for owner-only changes), and the command; read-only
  chain     a continuous chain of sessions over the road: start | next | status | watch | stop | resume | join
  owner     what waits on the owner, with the command that performs each (--json for tools); read-only.
            `owner run`: the owner runs the acts a waiting chain lists in owner.md, and records what passed
  rule      the owner rules on a proposed decision: status, a Ruling line, the index, one commit as the owner
  approve   the owner approves or rejects a proposed change request, in one commit
  rail      the owner sets the status of a rail in charter/rails.md, in one commit
  version   print the installed version
"""
from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import lib      # noqa: E402
import checks   # noqa: E402
import rails   # noqa: E402
import owner as ownerq   # noqa: E402


def today() -> str:
    return dt.date.today().isoformat()


# ---------------------------------------------------------------- check

GATES = ("scope", "size", "done", "decisions", "memory", "perimeter", "changes", "protected", "rails")


def cmd_check(a) -> int:
    root = lib.repo_root(a.root)
    rep = checks.Report()
    gates = {g for g in GATES if getattr(a, g, False)} or set(GATES)
    # at commit the artifacts are read as staged: the gates judge the commit, not the working tree
    with (lib.index_view(root) if a.staged else contextlib.nullcontext()):
        cfg = lib.load_config(root)
        _check(a, root, cfg, gates, rep)
    # a config the gates cannot read as written is refused, not skipped: it is the owner's input, not a gate error
    rep.add(*(checks.Finding("config", "block", f"charter/config.json: {m}", path="charter/config.json",
                             override="the owner corrects charter/config.json (owner-only); `charter config` lists what is read")
              for m in cfg.get(lib.PROBLEMS, [])))
    for f in rep.findings:
        lib.log_event(root, "cli" if not a.ci else "ci", f.gate, f.level, f.message, path=f.path, mode="staged" if a.staged else "all")
    for f in rep.findings:
        print(f.line())
    n_b, n_w = len(rep.blocks), len(rep.warns)
    print(f"charter check: {n_b} blocking, {n_w} warning(s) [{'staged' if a.staged else 'tree'}, {lib.config_line(cfg)}]")
    if n_b:
        print("Refused. Each line above names its override. `git commit --no-verify` skips this hook; CI runs it again.")
        return 1
    return 0


def _check(a, root: Path, cfg: dict, gates: set, rep) -> None:
    done_st = lib.as_list(cfg.get("done_statuses"))
    decs = checks.decision_index(root)
    tracked = [p for p in lib.git(root, "ls-files").stdout.splitlines() if p.strip()]
    base = None
    if a.staged:
        paths = checks.staged_paths(root)
        texts = {p: checks.staged_text(root, p) for p in paths}
        changed = paths
        renamed = checks.rename_sources(root)

        def old(p):
            r = lib.git(root, "show", f"HEAD:{p}")
            return r.stdout if r.returncode == 0 else None

        def new(p):
            return texts.get(p, "")
    else:
        paths = tracked
        base = checks.usable_base(root, a.base)
        changed = checks.changed_paths(root, a.base) if base else None
        renamed = checks.rename_sources(root, base) if base else {}
        if changed is None:
            changed = list(tracked)
            rep.add(checks.Finding("error", "warn", f"base {a.base or 'HEAD~1'} is not usable in this clone (an all-zero SHA, a SHA a force-push removed, "
                                   "or no parent commit); every tracked path is treated as changed"))

        def old(p):
            return checks.base_text(root, base, p) if base else None

        def new(p):
            try:
                return (root / p).read_text(encoding="utf-8", errors="replace")
            except OSError:
                return ""
    changed_set = set(changed)
    units = lib.taskets(root)
    unit = units.get(lib.active_unit(root) or "")
    probes_on = a.probe if a.probe is not None else bool(
        (cfg.get("probes") or {}).get("at_commit" if a.staged else "in_ci" if a.ci else "", False))

    if "scope" in gates:
        rep.add(*checks.check_scope(root, cfg, changed))
        if not a.staged:
            for f in checks.check_scope(root, cfg, [p for p in paths if p not in changed_set]):
                if f.level == "block":
                    rep.add(checks.Finding("scope", "warn", f"legacy: {f.message.split(' and no approved')[0]} (present before this change set; retire, move, or cover it by a change request)", path=f.path))
        for u in units.values():
            rep.add(*checks.check_unit_scope(root, cfg, u))
        rep.add(*checks.check_scope_file(root, cfg))
    if "rails" in gates:
        rep.add(*rails.check(root, cfg, units, changed_set, only_changed=a.staged))
    if "changes" in gates:
        rep.add(*checks.check_changes(root))
        rep.add(*[f for f in checks.duplicate_ids(root) if f.gate == "changes"])
    if "size" in gates:
        for p in paths:
            if not a.staged and not a.strict and p not in changed_set:
                continue   # untouched in this change set: a file already over the limit is not refused again
            text = new(p)
            if lib.is_binary(text):
                continue   # a line count means nothing for binary content
            prev = old(renamed.get(p, p))   # a renamed file is measured against its old name, not as new
            new_lines = lib.line_count(text)
            old_lines = 0 if (a.strict or prev is None) else lib.line_count(prev)
            old_bytes = 0 if (a.strict or prev is None) else len(prev.encode("utf-8"))
            rep.add(*checks.check_size(root, cfg, p, new_lines, old_lines, len(text.encode("utf-8")), old_bytes))
        rep.add(*checks.check_size_exceptions(cfg, today()))
    if "done" in gates:
        closing = []
        for p in paths:
            if not (p.startswith(lib.TASKETS_DIR + "/") and p.endswith(".md")):
                continue
            if not a.strict and p not in changed_set:
                continue   # judged when its status changed; a unit accepted earlier is not judged again
            text, prev = new(p), old(p)
            status = str(lib.split_frontmatter(text)[0].get("status", ""))
            prev_status = str(lib.split_frontmatter(prev or "")[0].get("status", ""))
            rep.add(*checks.check_acceptance_change(prev or "", text, p))
            if status not in done_st or (prev_status == status and not a.strict):
                continue
            found = checks.check_unit_done(root, cfg, text, p)
            rep.add(*found)
            if lib.acceptance(lib.split_frontmatter(text)[2]) and not any(f.level == "block" for f in found):
                closing.append((p, text))
        if probes_on and closing:
            dirty = checks.unstaged_paths(root) if a.staged else []
            if dirty:
                rep.add(checks.Finding("probe", "block", f"probes run in the working tree, which differs from the index for {', '.join(dirty[:5])}",
                                       override="stage everything, or `git stash --keep-index`, commit, `git stash pop`"))
            else:
                timeout = int((cfg.get("probes") or {}).get("timeout_s", 120))
                for p, text in closing:
                    found = checks.run_probes(root, text, p, timeout)[0]
                    rep.add(*found)
                    if not found:
                        rep.add(*checks.run_probes_at_base(root, cfg, text, p, timeout))
    if "decisions" in gates:
        for p in paths:
            if p.startswith(".charter/") or p.startswith("charter/decisions/"):
                continue
            text = new(p)
            if not text or lib.is_binary(text):
                continue
            rep.add(*checks.check_decisions_text(root, decs, p, text))
        rep.add(*[f for f in checks.duplicate_ids(root) if f.gate == "decisions"])
        for u in units.values():
            if str(u.get("status", "")) not in done_st and str(u.get("status", "")) not in lib.TERMINAL_STATUSES:
                rep.add(*checks.check_unit_decisions(root, decs, u))
        bound = [d for d in decs.values() if d.get("check") and str(d.get("status", "active")) == "active"
                 and (not a.staged or any(lib.matches_any(p, lib.as_list(d.get("binds"))) for p in paths))]
        dirty = checks.unstaged_paths(root) if (a.staged and bound) else []
        if dirty:
            rep.add(checks.Finding("decisions", "block", f"decision `check:` commands run in the working tree, which differs from the index for {', '.join(dirty[:5])}; "
                                   "they would judge files this commit does not contain",
                                   override="stage everything, or `git stash --keep-index`, commit, `git stash pop`"))
        else:
            rep.add(*checks.run_decision_checks(root, decs, only_bound_to=None if not a.staged else paths))
    if "perimeter" in gates and a.staged:
        rep.add(*checks.check_perimeter(root, cfg, unit, [p for p in paths if not p.startswith((lib.TASKETS_DIR, lib.CHARTER_DIR, lib.TOOL_DIR, ".claude/", ".github/"))], at_commit=True))
    if "memory" in gates:
        rep.add(*checks.check_memory(root, cfg, today()))
    if "protected" in gates:
        if a.staged:
            rep.add(*checks.check_owner_only_staged(root, cfg, paths))
        else:
            rep.add(*checks.check_manifest(root))
            if base:
                rep.add(*checks.check_owner_commits(root, cfg, base))


# ---------------------------------------------------------------- anchors

def cmd_anchors(a) -> int:
    """Exit 1 on any unanchored claim or unresolved anchor. With --pr (a pull-request description),
    `#123` counts as an anchor and the result is a warning: the method's posture for a check whose
    false positives have not yet been measured. On the prototype track every result is a warning
    (docs/method.md, Two tracks)."""
    root = lib.repo_root(a.root)
    warn_only = a.pr or lib.load_config(root).get("track") == "prototype"
    rc = 0
    for f in a.files:
        p = Path(f)
        text = p.read_text(encoding="utf-8", errors="replace") if p.exists() else sys.stdin.read()
        checks.DOC_DIR = p.resolve().parent if p.exists() else None
        rep = checks.check_anchors(root, text, min_len=a.min_len, issues=a.pr)
        status = "ok" if rep.ok else ("WARN" if warn_only else "FAIL")
        print(f"{f}: {status} — {rep.claims} claim(s), {rep.anchored} anchored, {rep.admitted} admitted unverified, "
              f"{len(rep.unanchored)} unanchored, {len(rep.unresolved)} unresolved anchor(s)")
        if a.pr and not text.strip():
            print("  warning: the description is empty; say what changed and cite the commits, the unit or the issue")
        for ln, t in rep.unanchored:
            print(f"  unanchored L{ln}: {t}")
        for ln, t in rep.unresolved:
            print(f"  unresolved L{ln}: {t}")
        lib.log_event(root, "cli", "anchors", "ok" if rep.ok else "warn" if warn_only else "block",
                      f"{len(rep.unanchored)} unanchored, {len(rep.unresolved)} unresolved", path=f, mode="pr" if a.pr else "doc")
        if not rep.ok and not warn_only:
            rc = 1
    return rc


# ---------------------------------------------------------------- synth

def _unit_state(root: Path, cfg: dict, u: dict, legacy: set[str] = frozenset(), before: set[str] = frozenset()) -> tuple[str, dict]:
    """The unit's state now. A commit SHA in the evidence of a unit whose done status is committed,
    and that this clone cannot resolve, is "historical": it resolved when the done gate judged it,
    and a squash or rebase merge has since removed it from the history.

    A done unit the done gate never judged is "done-before-charter", not "done-unaccepted": one listed in
    `legacy` (charter/legacy-taskets.txt) without `## Acceptance`, which the gate only warns on
    (checks.check_unit_done), or one whose path is in `before` (_done_before_charter) and whose committed
    status is still done. Missing evidence on those says nothing about work done under charter."""
    status = str(u.get("status", ""))
    body = u.get("_body", "")
    acc = lib.acceptance(body)
    boxes = checks.CHECKBOX_RE.findall(acc)
    k = checks.classify_anchors(root, lib.section(body, "Evidence"))
    done = status in lib.as_list(cfg.get("done_statuses"))
    historical = []
    if done and k["bad"]:
        committed = str(lib.split_frontmatter(checks.head_text(root, u["_path"]))[0].get("status", ""))
        if committed == status:
            historical = [b for b in k["bad"] if checks.SHA_RE.fullmatch(b)]
    bad = [b for b in k["bad"] if b not in historical]
    ok = k["fileline"] + k["sha"] + k["run"] + k["url"] + k["path"]
    log = [l.strip() for l in lib.section(body, "Log").splitlines() if l.strip()]
    info = {"boxes": len(boxes), "open": sum(1 for b in boxes if b[0] == " "), "evidence": ok, "bad": bad,
            "historical": historical, "log": log}
    if done:
        ran = k["sha"] or k["run"] or historical
        if boxes and info["open"] == 0 and ran and not bad:
            return "accepted", info
        if u["_id"] in legacy and not lib.section(body, "Acceptance"):
            return "done-before-charter", info
        if u["_path"] in before and str(lib.split_frontmatter(checks.head_text(root, u["_path"]))[0].get("status", "")) == status:
            return "done-before-charter", info
        return "done-unaccepted", info
    if status == "blocked":
        return "blocked", info
    if status in lib.TERMINAL_STATUSES:
        return "closed", info
    return ("in-progress" if log else "open"), info


def _done_before_charter(root: Path, cfg: dict) -> set[str]:
    """Unit paths whose last commit to add or remove a done status predates the commit that added
    charter/VERSION: done before the install, and not reopened since. One `git log` for every unit."""
    added = lib.git(root, "log", "--diff-filter=A", "--format=%cI", "--", f"{lib.CHARTER_DIR}/VERSION").stdout.split()
    if not added:
        return set()
    installed = dt.datetime.fromisoformat(added[-1])
    alts = "|".join(re.escape(s) for s in lib.as_list(cfg.get("done_statuses")))
    # -G lists only the files whose own diff matches, so each path is paired with its own status change
    r = lib.git(root, "log", "--format=%x00%cI", "--name-only", "-G", f"^status:[[:space:]]*({alts})([[:space:]]|#|$)", "--", lib.TASKETS_DIR)
    last: dict[str, dt.datetime] = {}
    for chunk in r.stdout.split("\0")[1:]:
        lines = [x for x in chunk.splitlines() if x.strip()]
        if lines:
            for path in lines[1:]:
                last.setdefault(path, dt.datetime.fromisoformat(lines[0]))   # newest first
    return {path for path, t in last.items() if t < installed}


def _first_done(root: Path, cfg: dict, u: dict) -> dt.datetime | None:
    """Commit time of the first commit that set the unit's status to a done value."""
    alts = "|".join(re.escape(s) for s in lib.as_list(cfg.get("done_statuses")))
    r = lib.git(root, "log", "--reverse", "--format=%cI", "-G", f"^status:[[:space:]]*({alts})([[:space:]]|#|$)", "--", u["_path"])
    first = r.stdout.split()[:1]
    return dt.datetime.fromisoformat(first[0]) if first else None


def _gate_counts(root: Path, days: int) -> dict[str, int]:
    """Events of the gate log over the last `days`, counted per `gate/decision`."""
    logp = lib.shared_state_dir(root) / "log.jsonl"
    counts: dict[str, int] = {}
    if not logp.exists():
        return counts
    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=days)).isoformat()
    for line in logp.read_text().splitlines():
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if r.get("ts", "") >= since:
            k = f"{r.get('gate')}/{r.get('decision')}"
            counts[k] = counts.get(k, 0) + 1
    return counts


def cmd_synth(a) -> int:
    root = lib.repo_root(a.root)
    cfg = lib.load_config(root)
    units = lib.taskets(root)
    decs = lib.decisions(root)
    chg = lib.change_requests(root)
    sc = lib.scope(root)
    head = lib.git(root, "rev-parse", "--short=12", "HEAD").stdout.strip() or "(no commits)"
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    L: list[str] = []
    L.append(f"# Progress synthesis — {now}")
    L.append("")
    L.append(f"Generated by `charter synth` from the repository at commit {head}; every line carries the file it was read from. Regenerate rather than edit.")
    L.append("")
    legacy, before = lib.legacy_taskets(root), _done_before_charter(root, cfg)
    states = {uid: _unit_state(root, cfg, u, legacy, before) for uid, u in units.items()}

    L.append("## Scope")
    if sc["exists"]:
        for sid, item in sc["in"].items():
            citing = [uid for uid, u in units.items() if sid in lib.as_list(u.get("scope"))]
            summary = ", ".join(f"{uid} ({states[uid][0]})" for uid in citing) or "no unit cites it"
            L.append(f"- {sid} — {item['title']}: {summary} (charter/scope.md)")
        for xid, item in sc["out"].items():
            approved = [cid for cid, c in chg.items() if str(c.get('status')) == 'approved' and any(lib.matches_any(p, lib.as_list(c.get('paths'))) for p in item['paths'])] if item['paths'] else []
            L.append(f"- {xid} — out of scope: {item['title']}" + (f"; approved change(s): {', '.join(approved)}" if approved else "") + " (charter/scope.md)")
    else:
        L.append(f"- No charter/scope.md; track is {cfg.get('track')} (charter/config.json)")
    L.append("")
    L += rails.synth_lines(root, cfg, units, lambda uid: states[uid][0])

    def unit_line(uid: str, u: dict, st: str, info: dict) -> str:
        ev = ", ".join(info["evidence"][:3]) if info["evidence"] else "no evidence anchors"
        hist = f"; {len(info['historical'])} historical commit(s) not reachable in this clone" if info["historical"] else ""
        extra = f"; last log: {info['log'][-1][:80]}" if info["log"] else ""
        return f"- {uid} — {u.get('title', '')} [{u.get('status')}]: {info['boxes'] - info['open']}/{info['boxes']} criteria closed; evidence: {ev}{hist}{extra} ({u['_path']})"

    for title, want in (("Done and accepted", "accepted"), ("Done but not accepted (evidence or criteria missing)", "done-unaccepted"),
                        ("In progress", "in-progress"), ("Open, not started", "open"), ("Blocked", "blocked")):
        rows = [(uid, u) for uid, u in units.items() if states[uid][0] == want]
        L.append(f"## {title}")
        if rows:
            for uid, u in rows:
                L.append(unit_line(uid, u, *states[uid]))
        else:
            L.append(f"- none ({lib.TASKETS_DIR}/, {len(units)} unit(s) read)")
        L.append("")
        if want == "done-unaccepted":
            # listed apart, only when there are some: the done gate never asked these for evidence
            old = [(uid, u) for uid, u in units.items() if states[uid][0] == "done-before-charter"]
            if old:
                L.append("## Done before charter (never judged by the done gate)")
                L += [f"- {uid} — {u.get('title', '')} [{u.get('status')}] ({u['_path']})" for uid, u in old]
                L.append("")

    L.append("## Open decisions and change requests")
    props = [(k, v) for k, v in decs.items() if str(v.get("status")) == "proposed"]
    pchg = [(k, v) for k, v in chg.items() if str(v.get("status")) == "proposed"]
    for k, v in props:
        L.append(f"- decision {k} — {v.get('title', '')} is proposed, waiting on {v.get('arbiter', 'the owner')} ({v['_path']})")
    for k, v in pchg:
        L.append(f"- change {k} — {v.get('title', '')} is proposed, waiting on the owner ({v['_path']})")
    if not props and not pchg:
        L.append(f"- none ({len(decs)} decision(s) in charter/decisions/, {len(chg)} change request(s) in charter/changes/)")
    L.append("")

    L.append("## Gate activity, last 30 days")
    if a.write:
        # the log is per machine; a committed synthesis would carry claims no clone can check
        L.append("- gate activity is recorded per machine and is not part of a written synthesis; `charter log` or `charter synth` prints it (.charter/bin/charter)")
    else:
        counts = _gate_counts(root, 30)
        for k, v in sorted(counts.items()):
            L.append(f"- {k}: {v} (outside this repository: the gate log in this machine's git directory)")
        if not counts:
            L.append("- no gate events recorded on this machine yet; the gates in .charter/bin/charter and .charter/hooks/ write them as they fire")
    L.append("")

    L.append("## Cost per accepted result")
    ledger = root / lib.CHARTER_DIR / "ledger.jsonl"
    if ledger.exists():
        # an unknown cost stays unknown: never added as zero, and every figure over it says it is a lower bound
        per_unit: dict[str, dict] = {}
        for line in ledger.read_text().splitlines():
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            d = per_unit.setdefault(r.get("unit") or "(none)", {"sessions": 0, "unknown": 0, "no_children": 0, "usd": 0.0,
                                                               "sub_usd": 0.0, "human_min": 0, "human_rows": 0, "ended": []})
            if r.get("source") == "human":
                d["human_min"] += int(r.get("human_minutes") or 0)
                d["human_rows"] += 1
                continue
            d["sessions"] += 1
            d["ended"].append(r.get("ts", ""))
            if r.get("est_usd") is None:
                d["unknown"] += 1
                continue
            d["usd"] += float(r["est_usd"])
            if r.get("subagent_est_usd") is None:
                d["no_children"] += 1
            else:
                d["sub_usd"] += float(r["subagent_est_usd"])
        # acceptance is the unit's state now, not what it was when the session was folded
        acc = [k for k in per_unit if k in states and states[k][0] == "accepted"]
        total = sum(v["usd"] for v in per_unit.values())
        human = sum(v["human_min"] for v in per_unit.values())
        n = sum(v["sessions"] for v in per_unit.values())
        unknown = sum(v["unknown"] for v in per_unit.values())
        no_children = sum(v["no_children"] for v in per_unit.values())
        complete = not unknown and not no_children
        none_known = bool(n) and unknown == n
        bound = "" if complete else "at least "
        total_txt = "no session cost known" if none_known else f"estimated total {bound}{total:.2f} USD"
        if not acc:
            per_acc = "no accepted unit yet"
        elif none_known:
            per_acc = "cost per accepted unit unknown"
        else:
            per_acc = f"{bound}{total / len(acc):.2f} USD per accepted unit" + ("" if complete else " (incomplete)")
        L.append(f"- {len(per_unit)} unit(s) with ledger records, {len(acc)} accepted, {total_txt}, {per_acc}, {human} human min recorded for "
                 f"{sum(1 for v in per_unit.values() if v['human_rows'])} of them (estimate from charter/config.json prices; charter/ledger.jsonl)")
        if not n:
            L.append("- cost coverage: no session recorded, only human time (charter/ledger.jsonl)")
        elif complete:
            L.append(f"- cost coverage: all {n} session(s) have a cost, subagents counted (charter/ledger.jsonl)")
        else:
            gaps = [f"{n - unknown} of {n} session(s) have a cost"]
            if no_children:
                gaps.append(f"{no_children} of those do not record subagent usage (recorded before charter 0.2.1, or a headless result)")
            L.append(f"- cost coverage: {'; '.join(gaps)}; the total and the cost per accepted unit are lower bounds (charter/ledger.jsonl)")
        for k, v in per_unit.items():
            first = _first_done(root, cfg, units[k]) if k in units else None
            rework = sum(1 for t in v["ended"] if first and t and dt.datetime.fromisoformat(t) > first)
            gaps = [f"{c} {what}" for c, what in ((v["unknown"], "without a cost"), (v["no_children"], "without subagents counted")) if c]
            if not v["sessions"]:
                usd = "no session recorded"
            elif v["unknown"] == v["sessions"]:
                usd = "cost unknown"
            elif gaps:
                usd = f"{', '.join(gaps)}, at least {v['usd']:.2f} USD estimated"
            else:
                usd = f"{v['usd']:.2f} USD estimated, {v['sub_usd']:.2f} of it by subagents"
            hm = f"{v['human_min']} human min" if v["human_rows"] else "no human time recorded"
            L.append(f"- {k}: {v['sessions']} session(s), {usd}, {rework} after the first done, "
                     f"{hm}, {'accepted' if k in acc else 'not accepted'} (charter/ledger.jsonl)")
    else:
        L.append("- no ledger yet: run `python3 .charter/bin/charter ledger fold` after sessions end to create charter/ledger.jsonl")
    text = "\n".join(L) + "\n"
    rep = checks.check_anchors(root, text)
    if not rep.ok:
        sys.stderr.write("charter synth: the synthesis failed its own anchoring check; not written.\n")
        for ln, t in rep.unanchored:
            sys.stderr.write(f"  unanchored L{ln}: {t}\n")
        for ln, t in rep.unresolved:
            sys.stderr.write(f"  unresolved L{ln}: {t}\n")
        return 1
    if a.write:
        out = root / (a.out or f"{lib.CHARTER_DIR}/progress.md")
        out.write_text(text, encoding="utf-8")
        print(f"wrote {lib.rel(root, out)} ({rep.claims} claim lines, all anchored)")
    else:
        sys.stdout.write(text)
    return 0


# ---------------------------------------------------------------- next

# The order open units are offered in: resume what has started before starting something new.
_NEXT_RANK = {"in-progress": 0, "open": 1, "blocked": 2}
FINISHED = ("accepted", "closed", "done-before-charter")


def _num(v, prefix: str = "") -> float:
    """A frontmatter number (`order: 3`, `priority: p1`) for sorting; a missing or odd value sorts last."""
    t = str(v).strip().lower()
    try:
        return float(t[len(prefix):] if prefix and t.startswith(prefix) else t)
    except ValueError:
        return float("inf")


def cmd_next(a) -> int:
    """Where the work stands and what comes next, from the project's own files: the active unit, the road's open
    items and the units on them, open units the road does not name, what waits on the owner, and the gates over
    the last 7 days. Read-only: it writes nothing, the gate log included, so any tool may run it at any time."""
    root = lib.repo_root(a.root)
    cfg = lib.load_config(root)
    units = lib.taskets(root)
    legacy, before = lib.legacy_taskets(root), _done_before_charter(root, cfg)
    states = {uid: _unit_state(root, cfg, u, legacy, before) for uid, u in units.items()}
    if a.json:
        print(json.dumps(_next_json(root, cfg, units, states, lib.active_unit(root, a.session)), indent=2, ensure_ascii=False))
        return 0
    n = max(1, a.limit)
    ver = (root / lib.CHARTER_DIR / "VERSION").read_text().strip() if (root / lib.CHARTER_DIR / "VERSION").exists() else "?"
    L = [f"charter {ver}, {lib.config_line(cfg)}"]
    L += [f"problem: charter/config.json: {m}. Commits and CI are refused until the owner corrects it." for m in cfg.get(lib.PROBLEMS, [])]
    if lib.hooks_path(root) != lib.CHARTER_HOOKS_PATH and not lib.hook_wired_by(root):
        L.append("The charter git hook is not active in this clone: " + ("tell the owner, since it runs other git hooks"
                 if lib.other_hooks(root) else "run `python3 .charter/bin/charter setup` once"))

    def line(uid: str, extra: str = "") -> str:
        u = units[uid]
        return f"- {uid} — {u.get('title', '')} [{u.get('status')}, {states[uid][0]}]{extra} ({u['_path']})"

    aid = lib.active_unit(root, a.session)
    L.append("")
    if aid and aid in units:
        st, info = states[aid]
        closed = info["boxes"] - info["open"]
        hint = ""
        if st == "accepted":
            hint = "; accepted, so `python3 .charter/bin/charter unit stop`"
        elif info["boxes"] and not info["open"] and st not in FINISHED:
            hint = "; every box is checked: finish it (probes, `## Evidence`, `status: done`)"
        L.append(f"Active unit: {aid} — {units[aid].get('title', '')} [{units[aid].get('status')}], "
                 f"{closed}/{info['boxes']} criteria closed{hint} ({units[aid]['_path']})")
    elif aid:
        L.append(f"Active unit: {aid}, which is not a tasket in {lib.TASKETS_DIR}/")
    else:
        L.append("Active unit: none. `python3 .charter/bin/charter unit start <id>` attributes the edits")

    open_ids = [uid for uid in units if states[uid][0] in _NEXT_RANK and uid != aid]
    loaded = rails.load(root, cfg)
    if loaded is not None:
        items, _ = loaded
        rc = rails.config(cfg)
        on = {uid: rails.rails_of(units[uid], rc["keys"], items) for uid in units}
        todo = []
        L += ["", f"Road ({rails.FILE}):"]
        for rid, it in rails.ordered(items):
            if it["status"] in rails.CLOSED:
                continue
            if it["status"] == "todo":
                todo.append(rid)
                continue
            citing = [uid for uid in units if rid in on[uid]]
            count: dict[str, int] = {}
            for uid in citing:
                count[states[uid][0]] = count.get(states[uid][0], 0) + 1
            L.append(f"- {rid} [{it['status']}]: " + (", ".join(f"{v} {k}" for k, v in count.items()) or "no unit cites it, so none can start"))
        if todo:
            L.append(f"- later ({len(todo)} todo): {', '.join(todo)}")
        seq = {rid: k for k, (rid, _) in enumerate(rails.ordered(items))}

        def road_key(uid: str):
            live = [seq[r] for r in on[uid] if r in items and items[r]["status"] not in rails.CLOSED]
            u = units[uid]
            return (min(live), _NEXT_RANK[states[uid][0]], _num(u.get("group_order")), _num(u.get("order")), uid)

        ahead = sorted((uid for uid in open_ids if any(r in items and items[r]["status"] not in rails.CLOSED for r in on[uid])), key=road_key)
        L += ["", "Next on the road:"]
        L += [line(uid, f" on {', '.join(r for r in on[uid] if r in items)}") for uid in ahead[:n]] or ["- no open unit names an open rail"]
        if len(ahead) > n:
            L.append(f"- +{len(ahead) - n} more (`--limit`)")
        live = {units[uid]["_path"] for uid in open_ids + ([aid] if aid in units else [])}
        off = [f for f in rails.check(root, cfg, units, None) if f.path in live]
        L += ["", "Off the road:"]
        L += [f"- {f.message} ({f.path})" for f in off[:n]] or ["- none"]
        if len(off) > n:
            L.append(f"- +{len(off) - n} more (`--limit`)")
    else:
        ahead = sorted(open_ids, key=lambda uid: (_NEXT_RANK[states[uid][0]], _num(units[uid].get("priority"), "p"),
                                                   _num(units[uid].get("group_order")), _num(units[uid].get("order")), uid))
        L += ["", f"Open units (no {rails.FILE}, so no road to order them by):"]
        L += [line(uid) for uid in ahead[:n]] or ["- none"]
        if len(ahead) > n:
            L.append(f"- +{len(ahead) - n} more (`--limit`)")

    unacc = [uid for uid in units if states[uid][0] == "done-unaccepted"]
    old = sum(1 for uid in units if states[uid][0] == "done-before-charter")
    L += ["", "Done without acceptance (the evidence is missing):"]
    L += [line(uid) for uid in unacc[:n]] or ["- none"]
    if len(unacc) > n:
        L.append(f"- +{len(unacc) - n} more (`charter synth`)")
    if old:
        L.append(f"- not counted: {old} unit(s) done before charter, which the done gate never judged (`charter synth` lists them)")

    owner = [ownerq.next_line(it) for it in ownerq.queue(root, cfg, units, {uid: st[0] for uid, st in states.items()})]
    L += ["", "Waiting on the owner:"] + (owner or ["- nothing"])

    counts = _gate_counts(root, 7)
    blocks = {k.split("/")[0]: v for k, v in counts.items() if k.endswith("/block")}
    warns = sum(v for k, v in counts.items() if k.endswith("/warn"))
    # the log's own words: a `block` is a refused edit or commit, or a probe that failed (a baseline fails on purpose)
    L += ["", "Gate log, last 7 days: " + (f"{sum(blocks.values())} block(s) ({', '.join(f'{g} {v}' for g, v in sorted(blocks.items()))}), "
                                          if blocks else "no block, ") + f"{warns} warning(s). `python3 .charter/bin/charter log --verbose` has the detail"]
    print("\n".join(L))
    return 0


def _int_or(v):
    """A frontmatter number as an int when it is one, else the value as written, or None when absent."""
    t = str(v).strip() if v is not None else ""
    return int(t) if re.fullmatch(r"-?\d+", t) else (t or None)


def _next_json(root: Path, cfg: dict, units: dict, states: dict, aid: str | None) -> dict:
    """The road a tool reads (`charter next --json`, 0.4.13): every rail of charter/rails.md in the road's order with
    every unit on it, the open units off the road, the done units without acceptance, and the size of the owner's
    queue. No `--limit` cut. `rails` is null for a project without charter/rails.md."""
    def row(uid: str) -> dict:
        u, (st, info) = units[uid], states[uid]
        return {"id": uid, "title": str(u.get("title", "")), "status": str(u.get("status", "")), "path": u["_path"],
                "group": str(u.get("group") or "") or None, "order": _int_or(u.get("order")), "state": st,
                "boxes": {"checked": info["boxes"] - info["open"], "total": info["boxes"]}}

    out_rails, off_road = None, []
    loaded = rails.load(root, cfg)
    if loaded is not None:
        items, _ = loaded
        keys = rails.config(cfg)["keys"]
        on = {uid: rails.rails_of(u, keys, items) for uid, u in units.items()}
        out_rails = []
        for rid, it in rails.ordered(items):
            citing = sorted((uid for uid in units if rid in on[uid]),
                            key=lambda uid: (_num(units[uid].get("group_order")), _num(units[uid].get("order")), uid))
            out_rails.append({"id": rid, "title": it["title"], "status": it["status"], "order": it["order"],
                              "units": [row(uid) for uid in citing]})
        for uid, u in units.items():
            if (states[uid][0] in _NEXT_RANK or uid == aid) and rails.is_open(u, cfg):
                why = rails.off_road(u, keys, items)
                if why is not None:
                    off_road.append({"id": uid, "reason": why[0], "path": u["_path"]})
    unacc = [uid for uid in units if states[uid][0] == "done-unaccepted"]
    queue = ownerq.queue(root, cfg, units, {uid: st[0] for uid, st in states.items()})
    return {**_schema(root), "active": aid, "rails": out_rails, "off_road": off_road,
            "done_without_acceptance": [{k: row(uid)[k] for k in ("id", "title", "status", "path")} for uid in unacc],
            "owner_waiting": len(queue)}


# ---------------------------------------------------------------- ledger

def _price(cfg: dict, model: str) -> dict:
    """The price row for a model id: the longest key it starts with, else "default"."""
    table = cfg.get("prices_usd_per_mtok") or {}
    keys = [k for k, v in table.items() if isinstance(v, dict) and k != "default" and model.startswith(k)]
    if keys:
        return table[max(keys, key=len)]
    if isinstance(table.get("default"), dict):
        return table["default"]
    if "input" in table:
        return table
    return lib.DEFAULT_CONFIG["prices_usd_per_mtok"]["default"]


def _est_usd(cfg: dict, usage: dict | None) -> float | None:
    """Estimated cost of a session from its token counts, priced per model when the record has them."""
    if not usage:
        return None
    rows = usage.get("by_model") or {"": usage}
    total = 0.0
    for model, u in rows.items():
        p = dict(_price(cfg, model))
        p.setdefault("cache_write_1h", 2 * float(p.get("input", 0)))   # the documented 1-hour multiplier
        total += sum(float(u.get(k, 0) or 0) * float(p.get(k, 0)) for k in ("input", "output", "cache_read", "cache_write", "cache_write_1h"))
    return round(total / 1_000_000, 4)


def cmd_ledger(a) -> int:
    root = lib.repo_root(a.root)
    cfg = lib.load_config(root)
    ledger = root / lib.CHARTER_DIR / "ledger.jsonl"
    units = lib.taskets(root)

    def accepted(uid: str) -> bool:
        u = units.get(uid)
        return bool(u) and _unit_state(root, cfg, u)[0] == "accepted"

    if a.action == "fold":
        src = lib.shared_state_dir(root) / "sessions.jsonl"
        if not src.exists():
            print(f"nothing to fold ({src} absent)")
            return 0
        have = set()
        if ledger.exists():
            for line in ledger.read_text().splitlines():
                try:
                    have.add(json.loads(line).get("session"))
                except json.JSONDecodeError:
                    pass
        n = 0
        with ledger.open("a", encoding="utf-8") as out:
            for line in src.read_text().splitlines():
                try:
                    r = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if r.get("session") in have:
                    continue
                usage = r.get("usage")
                rec = {"ts": r["ts"], "session": r["session"], "unit": r.get("unit", ""), "source": "interactive",
                       "usage": usage, "est_usd": _est_usd(cfg, usage),
                       # the subagents' share of est_usd; null when the record predates counting them
                       "subagent_est_usd": _est_usd(cfg, (usage or {}).get("subagents")) if (usage or {}).get("children_included") else None,
                       "accepted": accepted(r.get("unit", "")),
                       "note": r.get("note", "") + " est_usd is an estimate from charter/config.json prices"}
                out.write(json.dumps(rec) + "\n")
                n += 1
        print(f"folded {n} session record(s) into {lib.rel(root, ledger)}")
        return 0
    if a.action == "add" and a.human_minutes is not None:
        rec = {"ts": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "session": "", "source": "human",
               "unit": a.unit or lib.active_unit(root) or "", "human_minutes": a.human_minutes, "note": a.note or ""}
        with ledger.open("a", encoding="utf-8") as out:
            out.write(json.dumps(rec) + "\n")
        print(f"recorded {a.human_minutes} human min for unit {rec['unit'] or '(none)'}")
        return 0
    if a.action == "add":
        data = json.loads(Path(a.result).read_text()) if a.result else json.loads(sys.stdin.read())
        if isinstance(data, list):   # stream-json: take the result line
            data = next((d for d in reversed(data) if d.get("type") == "result"), data[-1])
        rec = {"ts": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "session": data.get("session_id", ""),
               "unit": a.unit or lib.active_unit(root) or "", "source": "headless", "usage": data.get("usage"),
               "est_usd": data.get("total_cost_usd"), "num_turns": data.get("num_turns"), "duration_ms": data.get("duration_ms"),
               "accepted": accepted(a.unit or lib.active_unit(root) or ""), "note": "total_cost_usd as reported by claude -p (client-side estimate)"}
        with ledger.open("a", encoding="utf-8") as out:
            out.write(json.dumps(rec) + "\n")
        print(f"recorded session {rec['session'][:8]} for unit {rec['unit'] or '(none)'}: {rec['est_usd']} USD")
        return 0
    if a.action == "show":
        if not ledger.exists():
            print("no ledger")
            return 0
        for line in ledger.read_text().splitlines():
            r = json.loads(line)
            what = f"human_min={r.get('human_minutes')}" if r.get("source") == "human" else f"est_usd={r.get('est_usd')} accepted_at_fold={r.get('accepted')}"
            print(f"{r['ts']} {r.get('session', '')[:8] or '-'} unit={r.get('unit') or '-'} {r.get('source')} {what}")
        return 0
    return 2


# ---------------------------------------------------------------- unit

def cmd_unit(a) -> int:
    root = lib.repo_root(a.root)
    st = lib.local_state_dir(root)
    st.mkdir(parents=True, exist_ok=True)
    if a.action == "start":
        units = lib.taskets(root)
        if a.id not in units:
            print(f"no tasket with id {a.id} in {lib.TASKETS_DIR}/ (known: {', '.join(list(units)[:10])})")
            return 1
        try:   # in a chain session, a unit of a group that has not started waits for the current group's review
            import chain_groups
            why = chain_groups.unit_start_refusal(root, a.id)
        except Exception as e:
            why = ""
            lib.log_event(root, "cli", "chain", "error", f"unit start: group check failed, so it allows: {e!r}"[:500])
        if why:
            print(why)
            return 1
        (st / "active").write_text(a.id + "\n")
        own = lib.session_unit_file(root)
        if own is not None:
            own.write_text(a.id + "\n")   # this session's choice; the checkout's file is every session's
        cfg = lib.load_config(root)
        for f in checks.check_unit_scope(root, cfg, units[a.id]) + checks.check_unit_decisions(root, checks.decision_index(root), units[a.id]):
            print(f.line())
        env = os.environ.get("CHARTER_UNIT", "").strip()
        if env and env != a.id:
            print(f"note: CHARTER_UNIT={env} in the environment takes precedence over this choice")
        print(f"active unit: {a.id} — {units[a.id].get('title', '')}")
        return 0
    if a.action == "stop":
        for p in (st / "active", lib.session_unit_file(root)):
            if p is not None and p.exists():
                p.unlink()
        print("no active unit")
        return 0
    if a.json:
        out = _unit_json(root, a.id) if a.id else dict(zip(("active", "source"), lib.active_unit_source(root, a.session)))
        print(json.dumps({**_schema(root), **out}, indent=2, ensure_ascii=False))
        return 1 if "error" in out else 0
    aid = lib.active_unit(root, a.session)
    last = (st / "active").read_text().strip() if (st / "active").exists() else ""
    if not aid and last:
        print(f"no active unit (the checkout's last choice, {last}, is closed)")
    else:
        print(aid or "no active unit")
    return 0


JSON_SCHEMA = 1   # the version of the shapes `--json` prints; a new key keeps it, a changed or removed one bumps it


def _schema(root: Path) -> dict:
    ver = root / lib.CHARTER_DIR / "VERSION"
    return {"schema": JSON_SCHEMA, "charter": ver.read_text().strip() if ver.exists() else None}


_BULLET_RE = re.compile(r"^\s*[-*]\s+")


def _lines(text: str) -> list[str]:
    """A section's non-empty lines, without their list bullets."""
    return [_BULLET_RE.sub("", l).strip() for l in text.splitlines() if l.strip()]


def done_blockers(root: Path, cfg: dict, u: dict) -> list[str]:
    """Each reason the done gate would refuse `done` on this unit now; [] when it would pass. The gate's own
    `checks.check_unit_done`, on the unit's text with its status set to done, so the two cannot disagree. Probes are
    not run (`probes.at_commit` runs them at commit; `charter probe <id>` runs them on demand)."""
    text = (lib.artifact_root(root) / u["_path"]).read_text(encoding="utf-8", errors="replace")
    done = lib.as_list(cfg.get("done_statuses")) or ["done"]
    if str(u.get("status", "")) not in done:
        text = ownerq.set_field(text, "status", done[0]) if lib.split_frontmatter(text)[1] else f"---\nstatus: {done[0]}\n---\n{text}"
    return [f.message for f in checks.check_unit_done(root, cfg, text, u["_path"]) if f.level == "block"]


def _unit_json(root: Path, uid: str) -> dict:
    """One unit as the gates read it (`charter unit show <id> --json`, 0.4.13)."""
    cfg = lib.load_config(root)
    units = lib.taskets(root)
    u = units.get(uid)
    if u is None:
        return {"error": f"no tasket with id {uid} in {lib.TASKETS_DIR}/"}
    body = u.get("_body", "")
    text = (lib.artifact_root(root) / u["_path"]).read_text(encoding="utf-8", errors="replace")
    offset = len(text.splitlines()) - len(body.splitlines())   # the file line before the body's first, as owner_lines counts
    heading, start, acc = lib.acceptance_span(body)
    legacy = ownerq.legacy_re(root, cfg)
    rows = []
    for i, line in enumerate(acc.splitlines()):
        m = checks.BOX_LINE_RE.match(line)
        if not m:
            continue
        label = re.match(r"(AC-\d+)\b:?\s*", m.group(2))
        probe = checks.PROBE_RE.match(line)
        rows.append({"line": offset + start + i + 1, "label": label.group(1) if label else None,
                     "text": m.group(2)[label.end():].strip() if label else m.group(2).strip(),
                     "checked": m.group(1) != " ", "probe": probe.group(2).strip() if probe else None,
                     "owner": ownerq.is_owner_line(line, legacy)})
    loaded = rails.load(root, cfg)
    keys = rails.config(cfg)["keys"]
    on = rails.rails_of(u, keys, loaded[0]) if loaded is not None else rails.rail_ids(u, keys)
    return {"id": uid, "title": str(u.get("title", "")), "status": str(u.get("status", "")), "path": u["_path"],
            "rail": on[0] if on else None, "kind": str(u.get("kind") or "") or None,
            "perimeter": lib.as_list(u.get("perimeter")), "decisions": lib.as_list(u.get("decisions")),
            "gate": str(u.get("gate") or "") or None, "acceptance_heading": heading, "acceptance": rows,
            "evidence": _lines(lib.section(body, "Evidence")), "log": _lines(lib.section(body, "Log"))[-5:],
            "done_blockers": done_blockers(root, cfg, u)}


# ---------------------------------------------------------------- decisions index

def cmd_decisions(a) -> int:
    root = lib.repo_root(a.root)
    decs = lib.decisions(root)
    out = root / lib.CHARTER_DIR / "decisions" / "INDEX.md"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(lib.decision_index_text(decs), encoding="utf-8")
    print(f"wrote {lib.rel(root, out)} ({len(decs)} decision(s))")
    return 0


# ---------------------------------------------------------------- log

def cmd_log(a) -> int:
    root = lib.repo_root(a.root)
    logp = lib.shared_state_dir(root) / "log.jsonl"
    if not logp.exists():
        print("no log")
        return 0
    since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(days=a.days)).isoformat()
    counts: dict[str, int] = {}
    rows = []
    for line in logp.read_text().splitlines():
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if r.get("ts", "") < since:
            continue
        rows.append(r)
        k = f"{r.get('gate')}/{r.get('decision')}"
        counts[k] = counts.get(k, 0) + 1
    for k, v in sorted(counts.items()):
        print(f"{k}: {v}")
    if a.verbose:
        for r in rows[-a.tail:]:
            print(f"{r['ts']} {r.get('kind')} {r.get('gate')}/{r.get('decision')} {r.get('path', '')} {r.get('detail', '')[:100]}")
    return 0


def cmd_setup(a) -> int:
    """What a clone needs beyond the tracked files: the git hook path, which is repository config and
    is not cloned. Also moves state a 0.1.0 install left in .charter/state/. Safe to run again."""
    root = lib.repo_root(a.root)
    cur = lib.hooks_path(root)
    wired = lib.hook_wired_by(root)
    others = lib.other_hooks(root)
    if cur == lib.CHARTER_HOOKS_PATH:
        print("git hook already active (core.hooksPath = .charter/githooks)")
    elif wired and not a.replace_hooks:
        print(f"git hook: {wired} runs the charter gate; core.hooksPath left {cur or 'unset'}")
    elif others and not a.replace_hooks:
        print(f"KEEP git hooks: this clone runs {', '.join(others)}; pointing core.hooksPath at .charter/githooks would stop them. "
              f"Add `python3 -B {lib.CHARTER_HOOK_COMMAND}` to their pre-commit (.charter/githooks/README.md), "
              "or re-run with --replace-hooks to stop them.")
    else:
        lib.git(root, "config", "core.hooksPath", lib.CHARTER_HOOKS_PATH, check=True)
        print(f"git config core.hooksPath .charter/githooks (was {cur or 'unset'}); worktrees of this clone share it")
    old = root / lib.STATE_DIR
    moves = (("log.jsonl", lib.shared_state_dir(root)), ("sessions.jsonl", lib.shared_state_dir(root)), ("active", lib.local_state_dir(root)))
    for name, dest in moves:
        src = old / name
        if not src.exists():
            continue
        dest.mkdir(parents=True, exist_ok=True)
        if name == "active":
            if not (dest / name).exists():
                (dest / name).write_text(src.read_text())
        else:
            with (dest / name).open("a", encoding="utf-8") as f:
                f.write(src.read_text())
        src.unlink()
        print(f"moved {lib.rel(root, src)} to {dest / name}")
    return 0


def cmd_probe(a) -> int:
    root = lib.repo_root(a.root)
    cfg = lib.load_config(root)
    units = lib.taskets(root)
    u = units.get(a.id)
    if u is None:
        print(f"no tasket with id {a.id} in {lib.TASKETS_DIR}/")
        return 1
    text = (root / u["_path"]).read_text(encoding="utf-8")
    found, lines = checks.run_probes(root, text, u["_path"], a.timeout or int((cfg.get("probes") or {}).get("timeout_s", 120)))
    print("\n".join(lines))
    for f in found:
        print(f.line(), file=sys.stderr)
    lib.log_event(root, "cli", "probe", "block" if found else "passed", f"{len(lines)} probe(s) of {a.id}", path=u["_path"])
    return 1 if found else 0


def cmd_config(a) -> int:
    """The settings the gates read, and what in charter/config.json was not applied."""
    cfg = lib.load_config(lib.repo_root(a.root))
    print(lib.config_line(cfg))
    for m in cfg.get(lib.PROBLEMS, []):
        print(f"problem: charter/config.json: {m}")
    return 1 if cfg.get(lib.PROBLEMS) else 0


def cmd_handover(a) -> int:
    """Who commits what is staged: the same block the installer prints. With an owner-only change among it, the
    handover is recorded in the git directory and the block ends with the owner's line (0.4.12). The index and the
    tree are left as they are."""
    root = lib.repo_root(a.root)
    cfg = lib.load_config(root)
    staged = [x for x in lib.git(root, "diff", "--cached", "--name-only", "-z").stdout.split("\0") if x]
    if not staged:
        lib.clear_handover(root)
        print("nothing staged")
        return 0
    mine = list(checks.owner_only_staged(root, cfg, staged))
    msg = a.message or ownerq.handover_message(root, staged, mine)
    print("\n".join(lib.handover(root, staged, msg, mine)))
    return 0


def cmd_chain(a) -> int:
    """A continuous chain of sessions over the road; .charter/chain.py has the commands."""
    import chain
    return chain.main(a.rest, lib.repo_root(a.root))


# ---------------------------------------------------------------- the owner

def cmd_owner(a) -> int:
    """What waits on the owner (the list `charter next` ends with), each with the command that performs it.
    Read-only: it runs no check and no probe, it reports them. `charter owner run` runs the acts a waiting chain's
    owner.md lists, in the owner's shell (0.4.11). `charter owner commit` commits a recorded handover, as the owner (0.4.12)."""
    if a.action == "commit":
        # the checkout whose engine runs: the owner's line names it by absolute path, from whatever directory (0.4.12)
        return _owner_commit(lib.repo_root(a.root or Path(os.path.abspath(__file__)).parents[2]))
    root = lib.repo_root(a.root)
    if a.action == "run":
        return _owner_run(root, a)
    cfg = lib.load_config(root)
    units = lib.taskets(root)
    legacy, before = lib.legacy_taskets(root), _done_before_charter(root, cfg)
    states = {uid: _unit_state(root, cfg, u, legacy, before)[0] for uid, u in units.items()}
    rep = ownerq.report(root, cfg, ownerq.queue(root, cfg, units, states))
    print(ownerq.dumps(rep) if a.json else ownerq.human(rep))
    return 0


def _owner_run(root, a) -> int:
    import chain
    import owner_acts
    live = chain.live_session(root)
    if live:
        print(f"charter owner run: refused: this is session {live[1]} of chain {live[0]['id']}, and a chain session never performs "
              "the owner's acts. Put them in owner.md and hand over with `status: wait`.", file=sys.stderr)
        return 1
    ch = chain.load(root, a.id)
    if not ch:
        rec = lib.load_handover(root)
        waits = bool(rec) and not lib.handover_stale(root, rec)
        print("charter owner run: no chain here" + (f"; a handover waits on you, committed with this line:\n{lib.owner_line(root)}" if waits else ""),
              file=sys.stderr)
        return 1
    only = None
    if a.only:
        try:
            only = sorted({int(x) for x in a.only.replace(" ", "").split(",") if x})
        except ValueError:
            print(f"charter owner run: --only takes act numbers separated by commas, not {a.only!r}", file=sys.stderr)
            return 2
    return owner_acts.run(root, ch, only=only, assume_yes=a.yes)


def _owner_commit(root: Path) -> int:
    """`charter owner commit`: the owner commits the handover recorded by `charter handover` or the installer, exactly
    its paths, with its message (0.4.12; docs/design/owner-handover.md). The owner switch comes from the owner's line;
    this never sets it, so an agent's run is refused at commit as an agent's `git commit` is."""
    import chain
    live = chain.live_session(root)
    if live:
        print(f"charter owner commit: refused: this is session {live[1]} of chain {live[0]['id']}, and a chain session never "
              "commits the owner's change. Leave it staged and hand over with `status: wait`.", file=sys.stderr)
        return 1
    rec = lib.load_handover(root)
    if not rec:
        print(f"charter owner commit: nothing is handed over in {root}. `python3 .charter/bin/charter handover` records "
              "what is staged and prints the owner's line.", file=sys.stderr)
        return 1
    if lib.in_claude_code() and not lib.owner_session():
        print("charter owner commit: refused: inside Claude Code the commit gate refuses an owner-only change without the "
              "owner switch, and only the owner types it. An agent never runs this; it gives the owner this line:\n"
              + lib.owner_line(root), file=sys.stderr)
        return 1
    stale = lib.handover_stale(root, rec)
    if stale:
        branch_moved = stale.startswith("it was handed over on branch")
        if not branch_moved:   # it can never stand again; another branch may still be switched back to
            lib.clear_handover(root)
        print(f"charter owner commit: refused: {stale}. Nothing committed. "
              + ("Switch back to that branch, or " if branch_moved else "")
              + "`python3 .charter/bin/charter handover` records what is staged now and prints the line again.", file=sys.stderr)
        return 1
    branch = lib.git(root, "branch", "--show-current").stdout.strip()
    paths, msg = [str(p) for p in rec["paths"]], str(rec.get("message") or "Staged changes")
    staged = [x for x in lib.git(root, "diff", "--cached", "--name-only", "-z").stdout.split("\0") if x]

    def now(rp):
        if not (root / rp).exists():
            return None
        return lib.git(root, "hash-object", "--", rp).stdout.strip() or None

    changed = [p for p in paths if now(p) != (rec.get("staged") or {}).get(p)]
    left = [p for p in staged if p not in paths]
    print(f"charter owner commit: {len(paths)} file(s) on branch {branch}, as the owner: {msg}")
    if changed:
        print(f"  changed since the handover, committed as they are now ({len(changed)}): " + ", ".join(changed[:8])
              + (f" and {len(changed) - 8} more" if len(changed) > 8 else ""))
    if left:
        print(f"  staged but not handed over, left out ({len(left)}): " + ", ".join(left[:8]) + (f" and {len(left) - 8} more" if len(left) > 8 else ""))
    sys.stdout.flush()
    r = subprocess.run(["git", "-C", str(root), "commit", "-m", msg, "--", *paths])
    if r.returncode != 0:
        print("charter owner commit: the commit failed (above); the handover is kept. Once what git or the gate said is "
              "fixed, run the same line again.", file=sys.stderr)
        return r.returncode
    lib.clear_handover(root)
    sha = lib.git(root, "rev-parse", "--short", "HEAD").stdout.strip()
    print(f"committed {sha} on {branch}: {msg}")
    return 0


def _owner_verb(a, fn, *args, **kw) -> int:
    root = lib.repo_root(a.root)
    import chain
    live = chain.live_session(root)
    if live:
        # the verbs commit as the owner; a chain session that ran one would act for the owner instead of waiting on
        # them (cross-review, 2026-10-04)
        print(f"charter {a.cmd}: refused: this is session {live[1]} of chain {live[0]['id']}, and a chain session never performs "
              "the owner's act. Hand over with `status: wait` and name it under `## Wait`.", file=sys.stderr)
        return 1
    ownerq.warn_in_session()
    try:
        return fn(root, lib.load_config(root), *args, trailer=a.trailer, dry_run=a.dry_run, **kw)
    except ownerq.Refused as e:
        print(f"charter {a.cmd}: refused: {e}", file=sys.stderr)
        return 1


def cmd_rule(a) -> int:
    return _owner_verb(a, ownerq.rule, a.decision, a.status, by=a.by, note=a.note)


def cmd_approve(a) -> int:
    if a.reject and a.status == "approved":
        a.status = "rejected"
    elif a.reject:
        print("charter approve: --reject and a status other than rejected contradict each other", file=sys.stderr)
        return 2
    return _owner_verb(a, ownerq.approve, a.change, a.status, note=a.note)


def cmd_rail(a) -> int:
    return _owner_verb(a, ownerq.rail, a.id, a.status, note=a.note)


def cmd_version(a) -> int:
    root = lib.repo_root(a.root)
    p = root / lib.CHARTER_DIR / "VERSION"
    print(p.read_text().strip() if p.exists() else "not installed")
    return 0


GATE_COMMANDS = ("check", "anchors")


def _fail_open(a, e: BaseException) -> int:
    """A gate that crashes allows: it logs decision=error, says so on stderr and exits 0 (docs/method.md,
    The hard gates). A gate that breaks the tool is worse than a gate that misses once."""
    msg = f"charter {a.cmd}: internal error, so this gate allows (gates fail open; see `charter log`): {e!r}"
    try:
        lib.log_event(lib.repo_root(a.root), "ci" if getattr(a, "ci", False) else "cli", "error", "error", msg[:500],
                      mode="staged" if getattr(a, "staged", False) else a.cmd)
    except Exception:
        pass
    print(msg, file=sys.stderr)
    if os.environ.get("GITHUB_ACTIONS") == "true":   # the job passes, so put the error on the run's summary
        print("::warning title=charter gate error::" + msg.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A"))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="charter", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=None, help="repository root (default: from cwd)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check"); c.add_argument("--staged", action="store_true"); c.add_argument("--all", action="store_true")
    c.add_argument("--strict", action="store_true", help="report every file over the size limit and gate every done tasket, changed or not")
    c.add_argument("--ci", action="store_true")
    c.add_argument("--base", default=None, help="on --all, the ref the change set is measured against (default: HEAD~1)")
    for g in GATES:
        c.add_argument(f"--{g}", action="store_true")
    c.add_argument("--probe", dest="probe", action="store_true", default=None,
                   help="re-run the acceptance probes of units that close in the change set (default: charter/config.json `probes`)")
    c.add_argument("--no-probe", dest="probe", action="store_false")
    c.set_defaults(fn=cmd_check)
    pr = sub.add_parser("probe"); pr.add_argument("id"); pr.add_argument("--timeout", type=int, default=None); pr.set_defaults(fn=cmd_probe)
    an = sub.add_parser("anchors"); an.add_argument("files", nargs="+"); an.add_argument("--min-len", type=int, default=40)
    an.add_argument("--pr", action="store_true", help="a pull-request description: `#123` is an anchor, findings warn"); an.set_defaults(fn=cmd_anchors)
    s = sub.add_parser("synth"); s.add_argument("--write", action="store_true"); s.add_argument("--out", default=None); s.set_defaults(fn=cmd_synth)
    l = sub.add_parser("ledger"); l.add_argument("action", choices=["fold", "add", "show"]); l.add_argument("--result", default=None); l.add_argument("--unit", default=None)
    l.add_argument("--human-minutes", type=int, default=None, help="with add: record time a person spent on the unit"); l.add_argument("--note", default=None)
    l.set_defaults(fn=cmd_ledger)
    u = sub.add_parser("unit"); u.add_argument("action", choices=["start", "stop", "show"]); u.add_argument("id", nargs="?")
    u.add_argument("--json", action="store_true", help="with show: the active unit and where it came from; with show <id>: that unit as the gates read it")
    u.add_argument("--session", default=None, help="the Claude Code session whose active unit to read (default: CLAUDE_CODE_SESSION_ID)")
    u.set_defaults(fn=cmd_unit)
    d = sub.add_parser("decisions"); d.add_argument("action", choices=["index"]); d.set_defaults(fn=cmd_decisions)
    lg = sub.add_parser("log"); lg.add_argument("--days", type=int, default=30); lg.add_argument("--verbose", action="store_true"); lg.add_argument("--tail", type=int, default=50); lg.set_defaults(fn=cmd_log)
    st = sub.add_parser("setup"); st.add_argument("--replace-hooks", action="store_true", help="point core.hooksPath at .charter/githooks even though other git hooks run")
    st.set_defaults(fn=cmd_setup)
    cf = sub.add_parser("config", help="print the track and opt-ins the gates read, and any problem in charter/config.json")
    cf.set_defaults(fn=cmd_config)
    nx = sub.add_parser("next", help="where the work stands and what comes next; read-only")
    nx.add_argument("--limit", type=int, default=5, help="rows per list (default 5)")
    nx.add_argument("--json", action="store_true", help="the road a tool reads: every rail and unit, no --limit cut")
    nx.add_argument("--session", default=None, help="the Claude Code session whose active unit to read (default: CLAUDE_CODE_SESSION_ID)")
    nx.set_defaults(fn=cmd_next)
    ho = sub.add_parser("handover", help="who commits what is staged; for an owner-only change, record the handover and print the owner's line")
    ho.add_argument("-m", "--message", default=None, help="the commit message (default: `charter <version>` for an install or upgrade)")
    ho.set_defaults(fn=cmd_handover)
    ch = sub.add_parser("chain", help="a continuous chain of sessions over the road (`charter chain --help`)", add_help=False)
    ch.add_argument("rest", nargs=argparse.REMAINDER); ch.set_defaults(fn=cmd_chain)
    ow = sub.add_parser("owner", help="what waits on the owner, with the command for each; read-only. `owner run`: the owner runs a waiting chain's acts. "
                        "`owner commit`: the owner commits what is handed over")
    ow.add_argument("action", nargs="?", choices=["run", "commit"], help="run: run the acts of the waiting chain's owner.md in your shell, in order, "
                    "and record what passed. commit: commit the handover `charter handover` recorded, as the owner (the line it prints)")
    ow.add_argument("--json", action="store_true", help="the machine-readable queue a tool such as an owner desk reads")
    ow.add_argument("--only", default=None, help="with run: the acts to run again, by number (`2` or `2,5`)")
    ow.add_argument("--yes", action="store_true", help="with run: ask nothing (a high-risk act, a manual act)")
    ow.add_argument("--id", default=None, help="with run: the chain (default: the last one)"); ow.set_defaults(fn=cmd_owner)
    trailer = {"default": None, "help": "a git trailer for the commit, e.g. `Owner-Action: oa-7k2f (terminal)`"}
    ru = sub.add_parser("rule", help="the owner rules on a decision, in one commit")
    ru.add_argument("decision"); ru.add_argument("status", choices=list(ownerq.DECISION_RULINGS))
    ru.add_argument("--by", default=None, help="with superseded: the successor decision")
    ru.add_argument("--note", default=None); ru.add_argument("--trailer", **trailer)
    ru.add_argument("--dry-run", action="store_true", help="print the diff and the commit; change nothing"); ru.set_defaults(fn=cmd_rule)
    apv = sub.add_parser("approve", help="the owner approves or rejects a change request, in one commit")
    apv.add_argument("change"); apv.add_argument("status", nargs="?", default="approved", choices=list(ownerq.CHANGE_RULINGS))
    apv.add_argument("--reject", action="store_true"); apv.add_argument("--note", default=None); apv.add_argument("--trailer", **trailer)
    apv.add_argument("--dry-run", action="store_true", help="print the diff and the commit; change nothing"); apv.set_defaults(fn=cmd_approve)
    ra = sub.add_parser("rail", help="the owner sets a rail's status, in one commit")
    ra.add_argument("id"); ra.add_argument("status"); ra.add_argument("--note", default=None); ra.add_argument("--trailer", **trailer)
    ra.add_argument("--dry-run", action="store_true", help="print the diff and the commit; change nothing"); ra.set_defaults(fn=cmd_rail)
    v = sub.add_parser("version"); v.set_defaults(fn=cmd_version)
    a, extra = ap.parse_known_args(argv)
    if a.cmd == "chain":
        a.rest = extra + a.rest   # a leading option (`chain --help`) is not part of argparse's REMAINDER
    elif extra:
        ap.error(f"unrecognized arguments: {' '.join(extra)}")
    if a.cmd not in GATE_COMMANDS:
        return a.fn(a)
    try:
        return a.fn(a)
    except Exception as e:
        return _fail_open(a, e)


if __name__ == "__main__":
    sys.exit(main())
